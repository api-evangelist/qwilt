{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qwilt CDN Certificate Manager Certificate Templates Origin Allow List API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Origin Allow List",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the origin allow list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cert-manager.cqloud.com/api/1.0/network/device-ip"
          },
          "docs": "Retrieve the comprehensive list of IP addresses that Qwilt CDN may use to fetch content from your origin, grouped by ISP network."
        }
      ]
    }
  ],
  "bundled": true
}